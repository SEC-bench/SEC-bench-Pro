+//===--- XnuTypeSignature.h - XNU kalloc type signatures --------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+///
+/// \file
+/// Implements the granule classification used by XNU's signature based
+/// kalloc type segregation, as exposed by __builtin_xnu_type_signature,
+/// __builtin_xnu_type_summary and __builtin_xnu_types_compatible.
+///
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_AST_XNUTYPESIGNATURE_H
+#define LLVM_CLANG_AST_XNUTYPESIGNATURE_H
+
+#include "clang/AST/Type.h"
+#include "llvm/ADT/SmallVector.h"
+#include <cstdint>
+
+namespace clang {
+class ASTContext;
+
+/// The KT_GRANULE_* encodings from XNU's osfmk/kern/kalloc.h.  A granule's
+/// encoding is the bitwise OR of the encodings of every leaf overlapping it.
+enum XnuGranuleKind : unsigned {
+  XNU_GRANULE_PADDING = 0,
+  XNU_GRANULE_POINTER = 1,
+  XNU_GRANULE_DATA = 2,
+  XNU_GRANULE_DUAL = 4,
+  XNU_GRANULE_PAC = 8,
+};
+
+/// Compute the per-granule (8 byte) encoding sequence of \p T.
+///
+/// \p Granules is resized to ceil(sizeof(T) / 8) and filled in, except that a
+/// type which contains no scalar leaf at all (an empty record, a record whose
+/// only members are empty records or zero-length arrays, ...) produces an
+/// empty sequence regardless of its size.
+///
+/// \p T must be a complete, non variably-modified type.
+void computeXnuTypeGranules(const ASTContext &Ctx, QualType T,
+                            llvm::SmallVectorImpl<uint8_t> &Granules);
+
+/// Render the granule sequence of \p T as lowercase hexadecimal digits; this
+/// is the value of __builtin_xnu_type_signature(T).
+void getXnuTypeSignature(const ASTContext &Ctx, QualType T,
+                         llvm::SmallVectorImpl<char> &Out);
+
+/// Compute __builtin_xnu_type_summary(T): the OR over all granules g of
+/// (1 << g), i.e. KT_SUMMARY_GRANULE_TO_IDX applied to every granule.
+uint64_t getXnuTypeSummary(const ASTContext &Ctx, QualType T);
+
+} // namespace clang
+
+#endif // LLVM_CLANG_AST_XNUTYPESIGNATURE_H
diff --git a/clang/include/clang/Basic/Attr.td b/clang/include/clang/Basic/Attr.td
index 61ef3fb..8c6730e 100644
--- a/clang/include/clang/Basic/Attr.td
+++ b/clang/include/clang/Basic/Attr.td
@@ -5539,3 +5539,29 @@ def Personality : InheritableAttr {
   let Subjects = SubjectList<[Function]>;
   let Documentation = [PersonalityDocs];
 }
+
+def XnuUsageSemantics : InheritableAttr {
+  let Spellings = [Clang<"xnu_usage_semantics">];
+  let Args = [StringArgument<"Kind0">, StringArgument<"Kind1", 1>];
+  let Documentation = [Undocumented];
+  let AdditionalMembers = [{
+    /// The KT_GRANULE_* encoding (see clang/AST/XnuTypeSignature.h) that this
+    /// annotation forces for the annotated typedef or field.
+    unsigned getGranuleKind() const {
+      bool IsPointer = false, IsData = false;
+      for (llvm::StringRef S : {getKind0(), getKind1()}) {
+        if (S == "pointer")
+          IsPointer = true;
+        else if (S == "data")
+          IsData = true;
+      }
+      if (IsPointer && IsData)
+        return 4; // KT_GRANULE_DUAL
+      if (IsPointer)
+        return 1; // KT_GRANULE_POINTER
+      if (IsData)
+        return 2; // KT_GRANULE_DATA
+      return 0;   // KT_GRANULE_PADDING
+    }
+  }];
+}
