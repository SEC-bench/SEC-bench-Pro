+//===----------------------------------------------------------------------===//
+// XNU kalloc type signature traits.
+//
+// __builtin_xnu_type_signature(T)  -> const char *  (a string literal)
+// __builtin_xnu_type_summary(T)    -> unsigned long
+// __builtin_xnu_types_compatible(A, B) -> bool / int
+//
+// These fold to literals in Sema, so neither ExprConstant nor CodeGen needs to
+// know about them; the signature is an ordinary string literal, which gives
+// the pointer identity for equal signatures that XNU relies on.
+//===----------------------------------------------------------------------===//
+
+/// Diagnose an operand that cannot have a granule signature.  Returns true if
+/// a diagnostic was emitted.
+static bool CheckXnuTypeTraitOperand(Sema &S, TypeTrait Kind,
+                                     SourceLocation KWLoc,
+                                     const TypeSourceInfo *TSI) {
+  QualType T = TSI->getType();
+  // Apple points these diagnostics at the trait keyword, not at the operand.
+  SourceLocation Loc = KWLoc;
+
+  bool IsSummary = Kind == UTT_XnuTypeSummary;
+  StringRef Name = IsSummary ? "__builtin_xnu_type_summary"
+                             : "__builtin_xnu_type_signature";
+
+  if (T->isVariablyModifiedType()) {
+    S.Diag(Loc, diag::err_xnu_type_trait_variable_array) << IsSummary << T;
+    return true;
+  }
+
+  if (S.RequireCompleteType(
+          Loc, T, diag::err_sizeof_alignof_incomplete_or_sizeless_type, Name,
+          /*Sizeless=*/0))
+    return true;
+
+  if (T->isFunctionType()) {
+    S.Diag(Loc, diag::err_sizeof_alignof_function_type) << Name;
+    return true;
+  }
+
+  return false;
+}
+
+static ExprResult BuildXnuUnaryTypeTrait(Sema &S, TypeTrait Kind,
+                                         SourceLocation KWLoc,
+                                         ArrayRef<TypeSourceInfo *> Args,
+                                         SourceLocation RParenLoc) {
+  ASTContext &Ctx = S.Context;
+  QualType T = Args[0]->getType();
+  bool Dependent = T->isDependentType();
+
+  if (!Dependent && CheckXnuTypeTraitOperand(S, Kind, KWLoc, Args[0]))
+    return ExprError();
+
+  if (Kind == UTT_XnuTypeSummary) {
+    APValue Value;
+    if (!Dependent) {
+      unsigned Width = Ctx.getIntWidth(Ctx.UnsignedLongTy);
+      Value = APValue(llvm::APSInt(
+          llvm::APInt(Width, getXnuTypeSummary(Ctx, T)), /*isUnsigned=*/true));
+    }
+    return TypeTraitExpr::Create(Ctx, Ctx.UnsignedLongTy, KWLoc, Kind, Args,
+                                 RParenLoc, Value);
+  }
+
+  QualType StrPtrTy = Ctx.getPointerType(Ctx.CharTy.withConst());
+
+  if (Dependent) {
+    // Defer to instantiation, exactly like the standard type traits: the
+    // TypeTraitExpr is value dependent while its operand is, and
+    // TreeTransform::TransformTypeTraitExpr re-enters BuildTypeTrait with the
+    // substituted type, which then folds to the string literal below.  XNU
+    // needs this: IOOverrideTypedOperators() and the SMR macros apply the
+    // trait to a template parameter inside the constant initialiser of a
+    // kalloc_type view.
+    return TypeTraitExpr::Create(Ctx, StrPtrTy, KWLoc, Kind, Args, RParenLoc,
+                                 APValue());
+  }
+
+  SmallString<64> Sig;
