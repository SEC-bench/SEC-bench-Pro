diff --git a/clang/lib/AST/XnuTypeSignature.cpp b/clang/lib/AST/XnuTypeSignature.cpp
new file mode 100644
index 0000000..6e0ad52
--- /dev/null
+++ b/clang/lib/AST/XnuTypeSignature.cpp
@@ -0,0 +1,222 @@
+//===--- XnuTypeSignature.cpp - XNU kalloc type signatures ----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/AST/XnuTypeSignature.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/RecordLayout.h"
+#include "clang/Basic/TargetInfo.h"
+#include "llvm/Support/SaveAndRestore.h"
+
+using namespace clang;
+
+namespace {
+
+/// Sentinel meaning "no xnu_usage_semantics annotation".
+static constexpr unsigned NoKind = ~0u;
+
+static unsigned getAnnotatedKind(const Decl *D) {
+  if (const auto *A = D->getAttr<XnuUsageSemanticsAttr>())
+    return A->getGranuleKind();
+  return NoKind;
+}
+
+class XnuGranuleComputer {
+  const ASTContext &Ctx;
+  llvm::SmallVectorImpl<uint8_t> &G;
+  /// Whether any scalar leaf (including a bit-field of any width) was reached.
+  bool SawLeaf = false;
+  /// Set while walking the elements of an array.  Apple stops honouring field
+  /// level xnu_usage_semantics annotations below an array, though typedef
+  /// level annotations and __ptrauth still apply:
+  ///   struct M { uintptr_t v __kernel_data_semantics; };  -> "2"
+  ///   struct { struct M a;    }                           -> "2"
+  ///   struct { struct M a[2]; }                           -> "11"   (!)
+  /// XNU depends on this: the opaque lck_mtx_t / lck_spin_t / lck_rw_t are
+  /// exactly of that shape, and arrays of them sit inside kalloc'd types.
+  bool IgnoreFieldAttrs = false;
+
+public:
+  XnuGranuleComputer(const ASTContext &Ctx, llvm::SmallVectorImpl<uint8_t> &G)
+      : Ctx(Ctx), G(G) {}
+
+  bool sawLeaf() const { return SawLeaf; }
+
+  /// OR \p Kind into every granule overlapping [BitOff, BitOff + BitWidth).
+  void mark(uint64_t BitOff, uint64_t BitWidth, unsigned Kind) {
+    // Reaching a leaf at all is what makes a record non-empty, even when the
+    // leaf is a zero-width bit-field that covers no granule.
+    SawLeaf = true;
+    if (BitWidth == 0 || G.empty())
+      return;
+    uint64_t First = BitOff / 64;
+    if (First >= G.size())
+      return;
+    uint64_t Last = (BitOff + BitWidth - 1) / 64;
+    if (Last >= G.size())
+      Last = G.size() - 1;
+    for (uint64_t I = First; I <= Last; ++I)
+      G[I] |= static_cast<uint8_t>(Kind);
+  }
+
+  /// Classify a scalar leaf.
+  ///
+  /// Deliberate sugar quirks, both matching Apple's implementation:
+  ///  * xnu_usage_semantics is only honoured when it sits on the immediate
+  ///    typedef of the leaf type, so it survives exactly one typedef level.
+  ///  * __ptrauth is read off the *local* qualifiers, so it is lost through
+  ///    any typedef or __typeof__.
+  unsigned classify(QualType T) const {
+    if (const auto *TT = T->getAs<TypedefType>()) {
+      unsigned K = getAnnotatedKind(TT->getDecl());
+      if (K != NoKind)
+        return K;
+    }
+
+    if (T.getLocalQualifiers().getPointerAuth())
+      return XNU_GRANULE_PAC;
+
+    // _Atomic(void *) is still a pointer.
+    QualType V = T;
+    if (const auto *AT = V->getAs<AtomicType>())
+      V = AT->getValueType();
+
+    if (V->isPointerType() || V->isReferenceType() || V->isBlockPointerType() ||
+        V->isObjCObjectPointerType() || V->isNullPtrType())
+      return XNU_GRANULE_POINTER;
+
+    // Everything else, including member pointers, is data.
+    return XNU_GRANULE_DATA;
+  }
+
+  void visitType(QualType T, uint64_t BitOff) {
+    if (const ConstantArrayType *CAT = Ctx.getAsConstantArrayType(T)) {
+      uint64_t N = CAT->getSize().getZExtValue();
+      if (N == 0)
+        return;
+      QualType ET = CAT->getElementType();
+      uint64_t ESize = Ctx.getTypeSize(ET);
+      if (!ET->isRecordType() && !ET->isArrayType()) {
+        // Elements of an array are contiguous, so a scalar element type can be
+        // handled in one go; this keeps huge arrays cheap.
+        mark(BitOff, N * ESize, classify(ET));
+        return;
+      }
+      llvm::SaveAndRestore<bool> Save(IgnoreFieldAttrs, true);
+      for (uint64_t I = 0; I != N; ++I)
+        visitType(ET, BitOff + I * ESize);
+      return;
+    }
+
+    if (const RecordType *RT = T->getAs<RecordType>()) {
+      visitRecord(RT->getDecl(), BitOff, /*MostDerived=*/true);
+      return;
+    }
+
+    mark(BitOff, Ctx.getTypeSize(T), classify(T));
+  }
+
+  void visitRecord(const RecordDecl *RD, uint64_t BitOff, bool MostDerived) {
+    RD = RD->getDefinition();
+    if (!RD)
+      return;
+
+    const ASTRecordLayout &L = Ctx.getASTRecordLayout(RD);
+
+    if (const auto *CXXRD = dyn_cast<CXXRecordDecl>(RD)) {
+      // A vtable pointer introduced by this class is an ordinary pointer.
+      if (L.hasOwnVFPtr())
+        mark(BitOff, Ctx.getTargetInfo().getPointerWidth(LangAS::Default),
+             XNU_GRANULE_POINTER);
+
+      for (const CXXBaseSpecifier &B : CXXRD->bases()) {
+        if (B.isVirtual())
+          continue;
+        if (const CXXRecordDecl *BD = B.getType()->getAsCXXRecordDecl())
+          visitRecord(BD, BitOff + Ctx.toBits(L.getBaseClassOffset(BD)),
+                      /*MostDerived=*/false);
+      }
+
+      // Virtual bases only exist once, in the most derived object.
+      if (MostDerived) {
+        for (const CXXBaseSpecifier &B : CXXRD->vbases()) {
+          if (const CXXRecordDecl *BD = B.getType()->getAsCXXRecordDecl())
+            visitRecord(BD, BitOff + Ctx.toBits(L.getVBaseClassOffset(BD)),
+                        /*MostDerived=*/false);
+        }
+      }
+    }
+
+    for (const FieldDecl *FD : RD->fields()) {
+      // Flexible array members are silently ignored.
+      if (FD->getType()->isIncompleteArrayType())
+        continue;
+      if (FD->getType()->isVariablyModifiedType())
+        continue;
+
+      uint64_t Off = BitOff + L.getFieldOffset(FD->getFieldIndex());
+      unsigned K = IgnoreFieldAttrs ? NoKind : getAnnotatedKind(FD);
+
+      if (FD->isBitField()) {
+        if (K == NoKind)
+          K = classify(FD->getType());
+        mark(Off, FD->getBitWidthValue(), K);
+        continue;
+      }
+
+      if (K != NoKind) {
+        mark(Off, Ctx.getTypeSize(FD->getType()), K);
+        continue;
+      }
+
+      visitType(FD->getType(), Off);
+    }
+  }
+};
+
+} // namespace
+
+void clang::computeXnuTypeGranules(const ASTContext &Ctx, QualType T,
+                                   llvm::SmallVectorImpl<uint8_t> &Granules) {
+  Granules.clear();
+  if (T.isNull() || T->isIncompleteType() || T->isVariablyModifiedType() ||
+      T->isFunctionType())
+    return;
+
+  uint64_t Bytes = Ctx.getTypeSizeInChars(T).getQuantity();
+  Granules.assign((Bytes + 7) / 8, 0);
+
+  XnuGranuleComputer C(Ctx, Granules);
+  C.visitType(T, 0);
+
+  // A type with no scalar leaf at all has an empty signature, whatever its
+  // size: struct {}, struct { Empty e; }, struct { int a[0]; } ...
+  if (!C.sawLeaf())
+    Granules.clear();
+}
+
+void clang::getXnuTypeSignature(const ASTContext &Ctx, QualType T,
+                                llvm::SmallVectorImpl<char> &Out) {
+  llvm::SmallVector<uint8_t, 32> Granules;
+  computeXnuTypeGranules(Ctx, T, Granules);
+  Out.clear();
+  Out.reserve(Granules.size());
+  for (uint8_t G : Granules)
+    Out.push_back("0123456789abcdef"[G & 0xf]);
+}
+
+uint64_t clang::getXnuTypeSummary(const ASTContext &Ctx, QualType T) {
+  llvm::SmallVector<uint8_t, 32> Granules;
+  computeXnuTypeGranules(Ctx, T, Granules);
+  uint64_t Summary = 0;
+  for (uint8_t G : Granules)
+    Summary |= uint64_t(1) << (G & 0xf);
+  return Summary;
+}
