diff --git a/clang/lib/Sema/SemaDeclAttr.cpp b/clang/lib/Sema/SemaDeclAttr.cpp
index eb4a8c2..d7c50b8 100644
--- a/clang/lib/Sema/SemaDeclAttr.cpp
+++ b/clang/lib/Sema/SemaDeclAttr.cpp
@@ -7559,6 +7559,60 @@ static void handlePersonalityAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
       << AL.getAttrName();
 }
 
+static void handleXnuUsageSemanticsAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  // The annotation describes the granule class of a scalar leaf type, so it is
+  // only meaningful on a typedef or on a field, and never on a record type.
+  if (isa<TagDecl>(D)) {
+    S.Diag(AL.getLoc(), diag::err_xnu_usage_semantics_record) << AL;
+    return;
+  }
+
+  QualType T;
+  if (const auto *TD = dyn_cast<TypedefNameDecl>(D))
+    T = TD->getUnderlyingType();
+  else if (const auto *FD = dyn_cast<FieldDecl>(D))
+    T = FD->getType();
+  else {
+    S.Diag(AL.getLoc(), diag::err_xnu_usage_semantics_subject) << AL;
+    return;
+  }
+
+  QualType Elem = T;
+  while (const ArrayType *AT = S.Context.getAsArrayType(Elem))
+    Elem = AT->getElementType();
+  if (Elem->isRecordType()) {
+    S.Diag(AL.getLoc(), diag::err_xnu_usage_semantics_record) << AL;
+    return;
+  }
+
+  StringRef Kinds[2];
+  bool SeenPointer = false, SeenData = false;
+  for (unsigned I = 0, N = std::min(AL.getNumArgs(), 2u); I != N; ++I) {
+    StringRef Kind;
+    if (!S.checkStringLiteralArgumentAttr(AL, I, Kind))
+      return;
+
+    bool *Seen;
+    if (Kind == "pointer")
+      Seen = &SeenPointer;
+    else if (Kind == "data")
+      Seen = &SeenData;
+    else {
+      S.Diag(AL.getLoc(), diag::err_xnu_usage_semantics_invalid_kind) << Kind;
+      return;
+    }
+    if (*Seen) {
+      S.Diag(AL.getLoc(), diag::err_xnu_usage_semantics_repeated_kind) << Kind;
+      return;
+    }
+    *Seen = true;
+    Kinds[I] = Kind;
+  }
+
+  D->addAttr(::new (S.Context)
+                 XnuUsageSemanticsAttr(S.Context, AL, Kinds[0], Kinds[1]));
+}
+
 /// ProcessDeclAttribute - Apply the specific attribute to the specified decl if
 /// the attribute applies to decls.  If the attribute is a type attribute, just
 /// silently ignore it if a GNU attribute.
@@ -7765,6 +7819,9 @@ ProcessDeclAttribute(Sema &S, Decl *D, const ParsedAttr &AL,
   case ParsedAttr::AT_Aligned:
     handleAlignedAttr(S, D, AL);
     break;
+  case ParsedAttr::AT_XnuUsageSemantics:
+    handleXnuUsageSemanticsAttr(S, D, AL);
+    break;
   case ParsedAttr::AT_AlignValue:
     handleAlignValueAttr(S, D, AL);
     break;
